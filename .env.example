# Vor dem ersten Start nach .env kopieren:  cp .env.example .env
# Ohne .env bricht docker compose ab. Alle Werte duerfen leer bleiben.


# ---------------------------------------------------------------------------
# ENCRYPTION_KEY -- Schluessel der Datenbank. Ohne ihn sind die Daten verloren.
# Leer: der erste Start legt data/encryption.key an.
# Eintragen: Wert aus der Karte "Kennzahlen". .env nicht ins Backup von data/.
# Wechseln nur mit ./keytool.sh change; alte Schluessel auskommentiert lassen.
ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# BEHIND_PROXY -- 1, wenn ein Reverse Proxy mit HTTPS davor steht.
# Leer: Kriterion ist direkt erreichbar (Port 3100).
# BEHIND_PROXY=


# ---------------------------------------------------------------------------
# PUBLIC_ADDRESS -- Adresse, unter der Kriterion von aussen erreichbar ist.
# Pflicht fuer Mailversand und Selbstanmeldung, sonst optional.
# PUBLIC_ADDRESS=https://kriterion.beispiel.de
